# Copy this file to .env and adjust it before running docker compose.

# Image and listener
VAULT_IMAGE=ghcr.io/willjallen/vault:latest
VAULT_BIND_ADDRESS=127.0.0.1
VAULT_PORT=8000
BASE_DOMAIN=localhost
VAULT_PUBLIC_URL=http://localhost:8000
VAULT_SITE_NAME=Vault
VAULT_DEV_MODE=0
VAULT_TTL_SWEEP_INTERVAL_SECONDS=60
VAULT_MAX_UPLOAD_BYTES=5368709120
VAULT_TRANSFER_CHUNK_BYTES=33554432
VAULT_TRANSFER_SESSION_TTL_SECONDS=86400
VAULT_EXPORT_TTL_SECONDS=86400
VAULT_EXPORT_WORKERS=1
VAULT_EXPORT_MAX_ACTIVE_JOBS=256
VAULT_EXPORT_MAX_ACTIVE_JOBS_PER_USER=16
VAULT_EXPORT_ZIP_COMPRESSION_THRESHOLD_BYTES=3221225472
VAULT_EXPORT_ZIP_COMPRESSLEVEL=1

# Required for production. Use exactly 32 random bytes encoded as 64 hex
# characters. Generate with: openssl rand -hex 32
VAULT_SESSION_SECRET=
# During rotation only, list up to four prior 64-hex secrets, comma-separated.
VAULT_SESSION_SECRET_PREVIOUS=
VAULT_SESSION_COOKIE_SECURE=auto

# Auth mode: headers for a trusted reverse proxy, oidc for direct OIDC login.
VAULT_AUTH_MODE=headers
# Header/dev bootstrap only. OIDC administrators should use immutable subjects below.
VAULT_BOOTSTRAP_ADMIN_EMAILS=
VAULT_ADMIN_GROUPS=admin,vault-admin
VAULT_HEADER_AUTH_ISSUER=headers

# Required for header auth: direct source IP/CIDR of each trusted reverse proxy,
# comma-separated. Use the address as seen by Vault; a host proxy commonly appears
# as the Docker bridge gateway rather than 127.0.0.1.
FORWARDED_ALLOW_IPS=
VAULT_SECURITY_HEADERS_ENABLED=1
VAULT_HSTS_MAX_AGE_SECONDS=31536000
VAULT_HSTS_INCLUDE_SUBDOMAINS=0
VAULT_GZIP_MINIMUM_SIZE=1024
VAULT_GZIP_COMPRESSLEVEL=6

# OIDC settings, required only when VAULT_AUTH_MODE=oidc.
VAULT_OIDC_ISSUER=
VAULT_OIDC_BOOTSTRAP_ADMIN_SUBJECTS=
VAULT_OIDC_CLIENT_ID=
VAULT_OIDC_CLIENT_SECRET=
VAULT_OIDC_SCOPES=openid email profile
VAULT_OIDC_REDIRECT_URI=
VAULT_OIDC_CLIENT_AUTH=client_secret_basic
VAULT_OIDC_GROUPS_CLAIM=groups
VAULT_OIDC_EMAIL_CLAIM=email
VAULT_OIDC_NAME_CLAIM=name
VAULT_OIDC_USERNAME_CLAIM=preferred_username

# Local storage uses the single /data volume by default.
VAULT_STORAGE_BACKEND=local
VAULT_STORAGE_PREFIX=

# S3-compatible storage, required only when VAULT_STORAGE_BACKEND=s3.
# Docker readiness performs HeadBucket. On AWS, grant bucket-level s3:ListBucket;
# a prefix-conditioned ListBucket grant can still deny HeadBucket. Other providers
# must support and authorize the equivalent authenticated HEAD-bucket operation.
VAULT_S3_BUCKET=
VAULT_S3_REGION=us-east-1
VAULT_S3_ENDPOINT_URL=
# Development only: permit HTTP endpoints on localhost or loopback IP addresses.
VAULT_S3_ALLOW_INSECURE_LOCAL_HTTP=0
VAULT_S3_ACCESS_KEY_ID=
VAULT_S3_SECRET_ACCESS_KEY=
VAULT_S3_SESSION_TOKEN=

# Cloudflare R2 storage, required only when VAULT_STORAGE_BACKEND=r2.
# Docker readiness performs HeadBucket; the token and endpoint must support and
# authorize R2's equivalent authenticated HEAD-bucket operation.
VAULT_R2_BUCKET=
VAULT_R2_ACCOUNT_ID=
VAULT_R2_ACCESS_KEY_ID=
VAULT_R2_SECRET_ACCESS_KEY=
VAULT_R2_ENDPOINT_URL=
# Development only: permit HTTP endpoints on localhost or loopback IP addresses.
VAULT_R2_ALLOW_INSECURE_LOCAL_HTTP=0
